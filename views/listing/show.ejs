<% layout("/layouts/boilerplate") %>
    <div class="row">

        <div class="col-12 mb-3 show-div">

            <div class="card col mb-3 show-img-div">
                <h4 class="card-title mt-3 mb-0 ms-3">
                    <%=listing.title %>
                </h4>
                <img src="<%=listing.image%>" class="card-img-top col-8 mt-2" alt="image">
                <div class="card-body">

                    <p class="card-text">
                        <%=listing.description %>
                            <br>
                            &#x20B9;<%=listing.price.toLocaleString("en-IN") %> / night
                    </p>
                    <p class="card-text"><small class="text-muted">
                            <div class="row">
                                <p>
                                    <%=listing.location %> /
                                        <%=listing.country %>
                                </p>
                                <p></p>
                            </div>
                        </small></p>
                </div>
                <div class="row">
                    <div class="col">
                        <a href="/listing/<%= listing._id %>/edit" class="btn btn-dark">Edit List</a>
                    </div>
                    <div class="col ">
                        <form action="/listing/<%= listing._id %>?_method=DELETE" method="post">
                            <button class="btn btn-dark show-btn">Delete Listing</button>
                        </form>
                    </div>
                </div>
            </div>

        </div>
        <hr>
        <div class="row">
            <div class="col-12 mb-3 ">
                <h4>Leave Review</h4>
                <form action="/listing/<%= listing.id %>/review" method="post" class="needs-validation" novalidate>
                    <input type="range" name="rating" id="range" min="1" max="5" class="form-range mt-3" required>
                    <div class="mt-3">
                        <label for="review" class="form-label">Comment</label>
                        <textarea type="text" name="comment" class="form-control" rows="3" required></textarea>
                        <div class="invalid-feedback">Give a short comment</div>
                    </div>
                    <br>
                    <button class="btn btn-outline-dark">Sumbit</button>
                </form>
            </div>
            <hr >
            <div class="review">
                <h4 class="offset-1">All review</h4>
                <div class="row offset-1 d-flex">
                    <% for(let rev of listing.review){%>
                        <div class="col-5 mb-3 me-4 border border-secondary rounded ps-2" >
                            <h4 class="mt-3 mb-0">Just do</h4>
                            <p class="card-text mb-3 mt-0"><%=rev.comment%>
                            </p>
                            <p><% for(let i=1; i<=rev.rating; i++){ %>
                            <i class="fa-solid fa-star" style="color: rgb(255, 221, 0); font-size:1.2rem;"></i>
                            <% } %>:
                            <%=rev.rating%>
                            </p>
                            <form action="/listing/<%= listing._id %>/review/<%= rev._id %>?_method=DELETE" method="POST">
                                <button class="btn btn-dark ps-3 pe-3 mb-3">Delet</button>
                            </form>
                        </div>
                    <% }%>
                </div>
            </div>
        </div>
        
    </div>