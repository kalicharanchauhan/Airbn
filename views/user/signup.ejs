<% layout("/layouts/boilerplate.ejs") %>
    <div class="row">
        <div class="col-8 offset-2">
            <h3 class="signup">Signup on Wanderlush</h3>
            <form action="/signup" method="post" novalidate class="needs-validation" class="signup-form">
                <div class="mb-3">
                    <label for="username" class="form-label">Username</label>
                    <input type="text" name="username" placeholder="Enter username" id="username" class="form-control" required>
                    <div class="valid-feedback">Username is good</div>
                </div>
                <div class="mb-3">
                    <label for="email" class="form-label">Email</label>
                    <input type="email" name="email" placeholder="Enter Email" id="email" class="form-control" required>
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">Password</label>
                    <input type="text" name="password" placeholder="Enter Password" id="password" class="form-control" required>
                    <div class="valid-feedback">Write you password anyware</div>
                </div>

                <button class="btn btn-outline-success">Sumbit</button>
            </form>
        </div>
    </div>